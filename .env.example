# ==============================================================================
# eholler / Eholler Local SEO - Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ==============================================================================

# Google Maps Platform API Key (Required for Places API (New) Business Audit)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth 2.0 Credentials (Required for Google Search Console Integration)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Authorized Redirect URI registered in Google Cloud Console.
# For local development: http://localhost:3000/api/connections/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback

# Application base URL (used for constructing redirect URIs if GOOGLE_REDIRECT_URI is not set)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI API Key (Optional: for AI recommendations and GBP description generation)
OPENAI_API_KEY=your_openai_api_key_here

# Neon PostgreSQL Database Connections
# Pooled connection URL (used by the application for query pooling with pgBouncer)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Direct connection URL (used by Prisma Migrate for schema migrations)
DIRECT_URL=postgresql://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Secret key for encrypting stored OAuth access & refresh tokens (AES-256-GCM, 32 bytes hex or base64)
TOKEN_ENCRYPTION_KEY=your_32_byte_secret_key_hex_or_base64_here
