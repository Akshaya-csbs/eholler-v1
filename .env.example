# Google Maps Platform API Key (Requires Places API (New) enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: OpenAI API Key for live AI Recommendations and Description generation
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google Search Console OAuth credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback
